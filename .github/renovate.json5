{
  // This is the only Renovate configuration this repository has.
  //
  // `useBaseBranchConfig` is not set, so a base branch run reuses this file
  // instead of the copy sitting on the branch it targets. Every rule that has to
  // apply to a maintenance branch belongs here, scoped with `matchBaseBranches`;
  // put it on the branch itself and Renovate will never see it.
  //
  // TODO: [release-duty] when `main` is cut into a new `stable/8.x`, the new
  // branch inherits a copy of this file that Renovate will never read. Left as
  // is, the copy freezes the `baseBranchPatterns` list as it was on the day of
  // the cut, and any rule someone later adds to it is silently ignored -- which
  // is exactly how stable/8.7, stable/8.8 and stable/8.9 ended up carrying rules
  // that never ran. Replace it on the new branch with the pointer stub those
  // three now use. See MAINTENANCE.md, "Release duty".
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>camunda/infraex-common-config:default.json5"],
  packageRules: [
    {
      // The Keycloak operator manifests and the Keycloak server image have to be the same
      // version: Keycloak releases them together and expects them to match. Both are
      // annotated against camunda/keycloak -- the CRs in
      // generic/kubernetes/operator-based/keycloak/keycloak-instance-*.yml carry the
      // prefixed tag, deploy.sh carries the bare version the manifest URLs need -- so they
      // already resolve to the same release. Grouping makes them land in the same pull
      // request too, instead of leaving the pair split across two merges.
      matchDatasources: ['docker'],
      matchPackageNames: ['camunda/keycloak'],
      groupName: 'camunda keycloak operator and image',
    },
  ],
  customManagers: [
    {
      // The 8.10 chart pin is a camunda-platform-helm *commit*, not a release tag: the
      // reference architectures need changes that are merged upstream but not in any
      // published tag. The shared preset's inline annotation cannot express that. Its
      // matchString only captures a digest in `@sha256:` form, so a bare 40-character git
      // SHA lands in `currentValue`, where `git-refs` cannot resolve it -- Renovate reads
      // the annotation and then drops it, which is exactly what `check-renovate-lookup`
      // fails the build on.
      //
      // Capturing the SHA as `currentDigest` against `currentValue: main` is what makes
      // `git-refs` offer a digest bump every time main moves. Arrays of mergeable options
      // concatenate, so this manager is added to the preset's rather than replacing it.
      customType: 'regex',
      // Every file, because the marker below is the opt-in and a second list of
      // paths is just somewhere to forget one. Each pin added since this manager
      // landed carried the marker and was missing from the list, so Renovate
      // silently never bumped it -- a frozen pin is the failure the marker exists
      // to prevent, and it leaves no trace when it happens.
      //
      // Matching the whole repository costs nothing here (about a thousand files)
      // and widens nothing: the marker is a deliberate token, so a file matches
      // only by asking to be tracked. This file mentions the marker inside
      // `matchStrings` but does not match it, since no SHA follows on the next
      // line -- keep it that way if this block is ever reordered.
      managerFilePatterns: ['/.*/'],
      // The marker comment, then the SHA anywhere on the line below it. Deliberately not
      // anchored on `datasource=`, so the preset's manager never matches these lines.
      matchStrings: [
        'renovate-helm-main[^\\n]*\\r?\\n[^\\n]*?(?<currentDigest>[0-9a-f]{40})',
      ],
      currentValueTemplate: 'main',
      datasourceTemplate: 'git-refs',
      depNameTemplate: 'https://github.com/camunda/camunda-platform-helm',
    },
  ],
  baseBranchPatterns: [
    'main',
    // TODO: [release-duty] remove branches whose maintenance period has ended and add the new stable branch
    'stable/8.7',
    'stable/8.8',
    'stable/8.9',
  ]
}
