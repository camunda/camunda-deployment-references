# Not called `.tf` as terraform-docs and actions docs are fighting for the README
# Neither have a good way to ignore

# Provider set for reference architectures whose state spans an arbitrary number
# of regions through numbered provider aliases (`region_1`, `region_2`, ...),
# rather than the owner/accepter pair of the dual-region architectures.
#
# `terraform destroy` is run against an otherwise empty configuration, so every
# resource in the state is an orphan. Terraform still resolves each one to the
# provider configuration recorded in the state, and refuses to destroy anything
# whose provider is missing:
#
#   Error: Provider configuration not present
#   To work with module.eks_cluster_region_1[0]... (orphan) its original
#   provider configuration at provider["...aws"].region_1 is required, but it
#   has been removed.
#
# Every alias the state can reference therefore has to be declared here, and
# pointed at the right region, or the teardown silently leaks a whole regional
# deployment.
#
# Regions are variables so that the caller drives them; export TF_VAR_region_N
# from the workflow to match the architecture's region slots.

terraform {

  backend "s3" {
    encrypt = true
  }

  required_version = ">= 1.3.0"
}

# Region slot 0, also the default provider.
provider "aws" {
  region = var.region_0
}

provider "aws" {
  region = var.region_1
  alias  = "region_1"
}

provider "aws" {
  region = var.region_2
  alias  = "region_2"
}

provider "aws" {
  region = var.region_3
  alias  = "region_3"
}

#### Variables

variable "region_0" {
  description = "Region of slot 0, which is also the default provider"
  default     = "us-east-1"
  type        = string
}

variable "region_1" {
  description = "Region of slot 1"
  default     = "us-east-2"
  type        = string
}

variable "region_2" {
  description = <<-EOT
    Region of slot 2. Defaults to slot 1 so that a state that never used this
    alias still initialises; an unused provider configuration creates and
    destroys nothing.
  EOT
  default     = "us-east-2"
  type        = string
}

variable "region_3" {
  description = "Region of slot 3. Defaults to slot 1, same rationale as slot 2."
  default     = "us-east-2"
  type        = string
}
