# Not called `.tf` as terraform-docs and actions docs are fighting for the README
# Neither have a good way to ignore

terraform {

  backend "s3" {
    encrypt = true
  }

  required_version = ">= 1.3.0" # Adjust Terraform version as needed

  # A destroy takes its providers from the state, with no constraint.
  # rhcs 1.7.11 was published without the provider binary.
  required_providers {
    rhcs = {
      source  = "terraform-redhat/rhcs"
      version = "!= 1.7.11"
    }
  }
}

provider "aws" {}
