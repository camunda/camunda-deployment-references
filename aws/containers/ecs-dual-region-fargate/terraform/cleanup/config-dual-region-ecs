# Not called `.tf` as terraform-docs and actions docs are fighting for the README
# Neither have a good way to ignore

# Provider set for the ECS dual-region Fargate architecture's three states
# (vpc/, infra/, app/).
#
# `aws-generic-terraform-cleanup` destroys a state against an otherwise empty
# configuration, so every resource in it is an orphan. Terraform still resolves
# each one to the provider configuration recorded in the state, and refuses to
# destroy anything whose provider is missing:
#
#   Error: Provider configuration not present
#   To work with module.aurora_global[0].aws_rds_cluster.secondary (orphan) its
#   original provider configuration at provider["...aws"].accepter is required,
#   but it has been removed.
#
# All three layers declare the same pair in their config.tf — the default
# provider in region 0 and `accepter` in region 1. The module-level aliases
# (aws.owner, aws.primary, aws.secondary) are mapped onto that pair by the
# `providers = {}` blocks at each module call, so they never appear in state
# and must not be declared here.
#
# Regions are variables so the caller drives them; export TF_VAR_region_0 and
# TF_VAR_region_1 from the workflow to match the deployment.

terraform {

  backend "s3" {
    encrypt = true
  }

  required_version = ">= 1.3.0"
}

# Region 0, also the default provider.
provider "aws" {
  region = var.region_0
}

provider "aws" {
  region = var.region_1
  alias  = "accepter"
}

#### Variables

variable "region_0" {
  description = "Region of the default provider, where the primary Aurora cluster and the region 0 VPC live"
  default     = "eu-west-2"
  type        = string
}

variable "region_1" {
  description = "Region of the `accepter` provider, where the secondary Aurora cluster and the region 1 VPC live"
  default     = "eu-west-3"
  type        = string
}
