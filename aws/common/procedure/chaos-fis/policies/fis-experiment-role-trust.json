{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "fis.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "ACCOUNT_ID_PLACEHOLDER"
        },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:fis:*:ACCOUNT_ID_PLACEHOLDER:experiment/*"
        }
      }
    }
  ]
}
