<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_multiRegionLoad" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="multiRegionLoad" name="Multi-region load generator" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_start_to_accept</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask_accept" name="Accept">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="multi-region-load-1" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_accept</bpmn:incoming>
      <bpmn:outgoing>Flow_accept_to_enrich</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_enrich" name="Enrich">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="multi-region-load-2" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_accept_to_enrich</bpmn:incoming>
      <bpmn:outgoing>Flow_enrich_to_settle</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_settle" name="Settle">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="multi-region-load-3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_enrich_to_settle</bpmn:incoming>
      <bpmn:outgoing>Flow_settle_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1">
      <bpmn:incoming>Flow_settle_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_to_accept" sourceRef="StartEvent_1" targetRef="ServiceTask_accept" />
    <bpmn:sequenceFlow id="Flow_accept_to_enrich" sourceRef="ServiceTask_accept" targetRef="ServiceTask_enrich" />
    <bpmn:sequenceFlow id="Flow_enrich_to_settle" sourceRef="ServiceTask_enrich" targetRef="ServiceTask_settle" />
    <bpmn:sequenceFlow id="Flow_settle_to_end" sourceRef="ServiceTask_settle" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="multiRegionLoad">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="173" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_accept_di" bpmnElement="ServiceTask_accept">
        <dc:Bounds x="259" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_enrich_di" bpmnElement="ServiceTask_enrich">
        <dc:Bounds x="409" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_settle_di" bpmnElement="ServiceTask_settle">
        <dc:Bounds x="559" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="709" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_to_accept_di" bpmnElement="Flow_start_to_accept">
        <di:waypoint x="209" y="120" />
        <di:waypoint x="259" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_accept_to_enrich_di" bpmnElement="Flow_accept_to_enrich">
        <di:waypoint x="359" y="120" />
        <di:waypoint x="409" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_enrich_to_settle_di" bpmnElement="Flow_enrich_to_settle">
        <di:waypoint x="509" y="120" />
        <di:waypoint x="559" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_settle_to_end_di" bpmnElement="Flow_settle_to_end">
        <di:waypoint x="659" y="120" />
        <di:waypoint x="709" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
